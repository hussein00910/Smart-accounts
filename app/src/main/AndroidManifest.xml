<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".SmartAccountsApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartAccounts">

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.addtransaction.AddTransactionActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".ui.settings.SettingsActivity" />

        <activity android:name=".ui.settings.currencies.CurrenciesActivity" />

        <activity android:name=".ui.backup.BackupActivity" />

        <activity android:name=".ui.backup.RestoreActivity" />

        <activity android:name=".ui.common.ComingSoonActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.smartaccounts.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
